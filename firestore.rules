rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Safe even when memberUids hasn't been backfilled onto a project yet
    // (falls back to the original owner check) — avoids the lockout where a
    // rule requiring memberUids denies access to the very documents the
    // one-time migration needs to read in order to add memberUids.
    function isProjectMember(projectId) {
      let proj = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return proj.userId == request.auth.uid ||
        (proj.memberUids != null && proj.memberUids.hasAny([request.auth.uid]));
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /projects/{projectId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (resource.data.memberUids != null && resource.data.memberUids.hasAny([request.auth.uid]))
      );
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    match /expenses/{expenseId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    match /paymentAccounts/{accountId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    match /paymentImports/{importId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    match /paymentTransactions/{transactionId} {
      allow read, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.userId == request.auth.uid ||
        (isProjectMember(resource.data.projectId) && resource.data.visibleToMembers == true)
      );
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    match /reconciliationActions/{actionId} {
      allow read: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
      // append-only audit log — no update/delete, by design
    }

    match /merchantRules/{ruleId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    match /salesInvoices/{docId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    match /purchaseOrders/{docId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    // Added 2026-09-09 to close a confirmed live gap — Income.jsx/
    // AccountCodes.jsx were shipped in code (MVP-2/MVP-3) without ever
    // getting a matching rule published. Same per-project shape as
    // salesInvoices/purchaseOrders above.
    match /income/{docId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    match /accountCodes/{codeId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

    match /accountCodeRules/{ruleId} {
      allow read, update, delete: if request.auth != null && isProjectMember(resource.data.projectId);
      allow create: if request.auth != null && isProjectMember(request.resource.data.projectId);
    }

  }
}
